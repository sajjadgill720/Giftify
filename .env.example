# Copy to .env at the repository root. Web loads this explicitly.
APP_URL=http://localhost:3000
# Leave empty for persistent embedded PostgreSQL in .local/database.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Database migration connection (privileged); runtime uses SET LOCAL ROLE art_app.
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_WEBHOOK_SECRET=
# Separate ops bearer credential; generate with node crypto.randomBytes(32).
OPS_TOKEN=
PAYMENT_MODE=sandbox
