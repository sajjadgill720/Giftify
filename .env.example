# Copy to .env at the repository root. Web loads this explicitly.
APP_URL=http://localhost:3000
# Leave empty for persistent embedded PostgreSQL in .local/database.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Database migration connection (privileged); runtime uses SET LOCAL ROLE art_app.
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
SAFEPAY_WEBHOOK_SECRET=
# Separate ops bearer credential; generate with node crypto.randomBytes(32).
OPS_TOKEN=
PAYMENT_MODE=sandbox
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Optional private backup of immutable print proofs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Real places: server-only provider key. Set the rights flag only after commercial
# printing, resale, stored-export and attribution terms have been confirmed.
MAPTILER_API_KEY=
MAP_PRINT_LICENSE_CONFIRMED=false
# Development/test only. Production photo uploads require private Supabase storage.
ASSET_STORAGE_ROOT=
